<?xml version="1.0" encoding="UTF-8"?>
<!--
ISO 19115 metadata in the ISO 19139:2007 'gmd' XML encoding
(namespace http://www.isotc211.org/2005/gmd)
Minimal XSD for validation of DGIWG-compliant GeoPackage metadata
(v0.27.0: renamed from iso19115-1.xsd - the content always validated the
2005 gmd encoding, the old filename was misleading)

This schema validates the core ISO 19115-1 elements used by the GeoPackage Creator.
Full standard available at: https://www.iso.org/standard/53798.html
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:gmd="http://www.isotc211.org/2005/gmd"
           xmlns:gco="http://www.isotc211.org/2005/gco"
           xmlns:gml="http://www.opengis.net/gml/3.2"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           targetNamespace="http://www.isotc211.org/2005/gmd"
           elementFormDefault="qualified">

  <xs:import namespace="http://www.isotc211.org/2005/gco"
             schemaLocation="iso19115-gco.xsd"/>

  <!-- Root element: MD_Metadata -->
  <xs:element name="MD_Metadata" type="gmd:MD_Metadata_Type"/>

  <xs:complexType name="MD_Metadata_Type">
    <xs:sequence>
      <!-- Required elements -->
      <xs:element name="fileIdentifier" type="gco:CharacterString_PropertyType" minOccurs="1"/>
      <xs:element name="language" type="gmd:LanguageCode_PropertyType" minOccurs="1" maxOccurs="unbounded"/>
      <xs:element name="characterSet" type="gmd:MD_CharacterSetCode_PropertyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="hierarchyLevel" type="gmd:MD_ScopeCode_PropertyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="contact" type="gmd:CI_ResponsibleParty_PropertyType" minOccurs="1" maxOccurs="unbounded"/>
      <xs:element name="dateStamp" type="gco:DateTime_PropertyType" minOccurs="1"/>
      <xs:element name="metadataStandardName" type="gco:CharacterString_PropertyType" minOccurs="0"/>
      <xs:element name="metadataStandardVersion" type="gco:CharacterString_PropertyType" minOccurs="0"/>

      <!-- Identification info -->
      <xs:element name="identificationInfo" type="gmd:MD_DataIdentification_PropertyType" minOccurs="1" maxOccurs="unbounded"/>

      <!-- Optional elements -->
      <xs:element name="metadataConstraints" type="gmd:MD_SecurityConstraints_PropertyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="dataQualityInfo" type="gmd:DQ_DataQuality_PropertyType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CI_ResponsibleParty -->
  <xs:complexType name="CI_ResponsibleParty_Type">
    <xs:sequence>
      <xs:element name="individualName" type="gco:CharacterString_PropertyType" minOccurs="0"/>
      <xs:element name="organisationName" type="gco:CharacterString_PropertyType" minOccurs="0"/>
      <xs:element name="contactInfo" type="gmd:CI_Contact_PropertyType" minOccurs="0"/>
      <xs:element name="role" type="gmd:CI_RoleCode_PropertyType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CI_ResponsibleParty_PropertyType">
    <xs:sequence>
      <xs:element name="CI_ResponsibleParty" type="gmd:CI_ResponsibleParty_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CI_Contact -->
  <xs:complexType name="CI_Contact_Type">
    <xs:sequence>
      <xs:element name="address" type="gmd:CI_Address_PropertyType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CI_Contact_PropertyType">
    <xs:sequence>
      <xs:element name="CI_Contact" type="gmd:CI_Contact_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CI_Address -->
  <xs:complexType name="CI_Address_Type">
    <xs:sequence>
      <xs:element name="country" type="gco:CharacterString_PropertyType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CI_Address_PropertyType">
    <xs:sequence>
      <xs:element name="CI_Address" type="gmd:CI_Address_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CI_RoleCode -->
  <xs:complexType name="CI_RoleCode_PropertyType">
    <xs:sequence>
      <xs:element name="CI_RoleCode" type="gmd:CI_RoleCode_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CI_RoleCode_Type">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="codeList" type="xs:anyURI" use="optional"/>
        <xs:attribute name="codeListValue" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- LanguageCode -->
  <xs:complexType name="LanguageCode_PropertyType">
    <xs:sequence>
      <xs:element name="LanguageCode" type="gmd:LanguageCode_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LanguageCode_Type">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="codeList" type="xs:anyURI" use="optional"/>
        <xs:attribute name="codeListValue" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- MD_CharacterSetCode -->
  <xs:complexType name="MD_CharacterSetCode_PropertyType">
    <xs:sequence>
      <xs:element name="MD_CharacterSetCode" type="gmd:MD_CharacterSetCode_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_CharacterSetCode_Type">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="codeList" type="xs:anyURI" use="optional"/>
        <xs:attribute name="codeListValue" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- MD_ScopeCode -->
  <xs:complexType name="MD_ScopeCode_PropertyType">
    <xs:sequence>
      <xs:element name="MD_ScopeCode" type="gmd:MD_ScopeCode_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_ScopeCode_Type">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="codeList" type="xs:anyURI" use="optional"/>
        <xs:attribute name="codeListValue" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- MD_DataIdentification -->
  <xs:complexType name="MD_DataIdentification_Type">
    <xs:sequence>
      <xs:element name="citation" type="gmd:CI_Citation_PropertyType" minOccurs="0"/>
      <xs:element name="abstract" type="gco:CharacterString_PropertyType" minOccurs="0"/>
      <xs:element name="language" type="gmd:LanguageCode_PropertyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="characterSet" type="gmd:MD_CharacterSetCode_PropertyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="topicCategory" type="gmd:MD_TopicCategoryCode_PropertyType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_DataIdentification_PropertyType">
    <xs:sequence>
      <xs:element name="MD_DataIdentification" type="gmd:MD_DataIdentification_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CI_Citation -->
  <xs:complexType name="CI_Citation_Type">
    <xs:sequence>
      <xs:element name="title" type="gco:CharacterString_PropertyType" minOccurs="1"/>
      <xs:element name="date" type="gmd:CI_Date_PropertyType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CI_Citation_PropertyType">
    <xs:sequence>
      <xs:element name="CI_Citation" type="gmd:CI_Citation_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CI_Date -->
  <xs:complexType name="CI_Date_Type">
    <xs:sequence>
      <xs:element name="date" type="gco:Date_PropertyType" minOccurs="1"/>
      <xs:element name="dateType" type="gmd:CI_DateTypeCode_PropertyType" minOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CI_Date_PropertyType">
    <xs:sequence>
      <xs:element name="CI_Date" type="gmd:CI_Date_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CI_DateTypeCode -->
  <xs:complexType name="CI_DateTypeCode_PropertyType">
    <xs:sequence>
      <xs:element name="CI_DateTypeCode" type="gmd:CI_DateTypeCode_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CI_DateTypeCode_Type">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="codeList" type="xs:anyURI" use="optional"/>
        <xs:attribute name="codeListValue" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- MD_TopicCategoryCode -->
  <xs:complexType name="MD_TopicCategoryCode_PropertyType">
    <xs:sequence>
      <xs:element name="MD_TopicCategoryCode" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- MD_SecurityConstraints -->
  <xs:complexType name="MD_SecurityConstraints_Type">
    <xs:sequence>
      <xs:element name="classification" type="gmd:MD_ClassificationCode_PropertyType" minOccurs="0"/>
      <xs:element name="classificationSystem" type="gco:CharacterString_PropertyType" minOccurs="0"/>
      <xs:element name="handlingDescription" type="gco:CharacterString_PropertyType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_SecurityConstraints_PropertyType">
    <xs:sequence>
      <xs:element name="MD_SecurityConstraints" type="gmd:MD_SecurityConstraints_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- MD_ClassificationCode -->
  <xs:complexType name="MD_ClassificationCode_PropertyType">
    <xs:sequence>
      <xs:element name="MD_ClassificationCode" type="gmd:MD_ClassificationCode_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_ClassificationCode_Type">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="codeList" type="xs:anyURI" use="optional"/>
        <xs:attribute name="codeListValue" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- DQ_DataQuality -->
  <xs:complexType name="DQ_DataQuality_Type">
    <xs:sequence>
      <xs:element name="scope" type="gmd:DQ_Scope_PropertyType" minOccurs="0"/>
      <xs:element name="report" type="gmd:DQ_DomainConsistency_PropertyType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DQ_DataQuality_PropertyType">
    <xs:sequence>
      <xs:element name="DQ_DataQuality" type="gmd:DQ_DataQuality_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DQ_Scope -->
  <xs:complexType name="DQ_Scope_Type">
    <xs:sequence>
      <xs:element name="level" type="gmd:MD_ScopeCode_PropertyType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DQ_Scope_PropertyType">
    <xs:sequence>
      <xs:element name="DQ_Scope" type="gmd:DQ_Scope_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DQ_DomainConsistency -->
  <xs:complexType name="DQ_DomainConsistency_Type">
    <xs:sequence>
      <xs:element name="result" type="gmd:DQ_ConformanceResult_PropertyType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DQ_DomainConsistency_PropertyType">
    <xs:sequence>
      <xs:element name="DQ_DomainConsistency" type="gmd:DQ_DomainConsistency_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DQ_ConformanceResult -->
  <xs:complexType name="DQ_ConformanceResult_Type">
    <xs:sequence>
      <xs:element name="explanation" type="gco:CharacterString_PropertyType" minOccurs="0"/>
      <xs:element name="pass" type="gco:Boolean_PropertyType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DQ_ConformanceResult_PropertyType">
    <xs:sequence>
      <xs:element name="DQ_ConformanceResult" type="gmd:DQ_ConformanceResult_Type" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
